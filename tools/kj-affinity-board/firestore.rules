rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isRootAdmin() {
      return request.auth != null && request.auth.token.email == 'nicolehsu2004@gmail.com';
    }

    function isAllowedTeacher() {
      return request.auth != null &&
        (isRootAdmin() ||
         exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)));
    }

    function isTeacherOf(classId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    // 白名單：只有管理者能新增/移除允許登入的老師信箱
    match /allowedEmails/{email} {
      allow read: if request.auth != null;
      allow write: if isRootAdmin();
    }

    function roomClassId(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.classId;
    }

    match /classes/{classId} {
      allow read: if true;
      allow create: if isAllowedTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacherOf(classId);

      match /students/{studentId} {
        allow read: if true;
        allow write: if isTeacherOf(classId);
      }
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isTeacherOf(request.resource.data.classId);
      allow update: if isTeacherOf(resource.data.classId);
      allow delete: if isTeacherOf(resource.data.classId);

      match /categories/{catId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['label', 'order']) &&
          request.resource.data.label is string && request.resource.data.label.size() > 0;
        allow update, delete: if isTeacherOf(roomClassId(roomId));
      }

      match /joined/{studentId} {
        allow read: if true;
        allow create: if isTeacherOf(roomClassId(roomId)) ||
          (request.resource.data.keys().hasAll(['seatNo', 'deviceToken', 'joinedAt', 'noteCount']) &&
           request.resource.data.noteCount == 0);
        allow update: if isTeacherOf(roomClassId(roomId)) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatNo', 'deviceToken', 'joinedAt']) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noteCount']) &&
           request.resource.data.noteCount == resource.data.noteCount + 1);
        allow delete: if isTeacherOf(roomClassId(roomId));
      }

      match /notes/{noteId} {
        allow read: if true;
        allow create: if request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 40 &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/joined/$(request.resource.data.studentId)) &&
          (get(/databases/$(database)/documents/rooms/$(roomId)).data.maxNotesPerStudent == 0 ||
           get(/databases/$(database)/documents/rooms/$(roomId)/joined/$(request.resource.data.studentId)).data.noteCount <
             get(/databases/$(database)/documents/rooms/$(roomId)).data.maxNotesPerStudent);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categoryId', 'groupId']) ||
          isTeacherOf(roomClassId(roomId));
        allow delete: if isTeacherOf(roomClassId(roomId));
      }
    }
  }
}
